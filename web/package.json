{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "state-map": "bash scripts/state-map.sh",
    "typecheck": "node scripts/css-types.mjs && node node_modules/tsc7/bin/tsc -p .",
    "test": "vitest run",
    "test:state": "vitest run --coverage --coverage.include=src/cartStore.ts --coverage.include=src/cartSlice.ts --coverage.include=src/queryClient.ts --coverage.include=src/hooks/** --coverage.include=src/components/SearchBox.tsx --coverage.include=src/components/Reviews.tsx --coverage.include=src/components/ReviewForm.tsx --coverage.include=src/components/ThemeToggle.tsx --coverage.reporter=text",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.15.0",
    "@tanstack/react-query": "^5.108.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^31.0.1",
    "tsc7": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.1",
    "vitest": "^5.1.1"
  }
}
